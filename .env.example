# Скопируйте в .env и при необходимости поменяйте значения.
# Файл .env в репозиторий не коммитится (см. .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=kafka_sink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- pgAdmin ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- ClickHouse ---
CLICKHOUSE_DB=kafka_sink
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse

# --- Генератор ---
# Пауза между тиками, секунд
GEN_INTERVAL_SEC=2
# Сколько записей каждого вида отправлять за тик
GEN_ORDERS_PER_TICK=3
GEN_EVENTS_PER_TICK=10
GEN_METRICS_PER_TICK=20
# 0 = работать бесконечно, иначе остановиться после N тиков
GEN_MAX_TICKS=0
